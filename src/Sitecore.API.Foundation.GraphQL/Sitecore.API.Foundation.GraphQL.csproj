<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <!-- NuGet package metadata -->
    <PackageId>SitecoreAPIGraphQLClient</PackageId>
    <Title>Sitecore GraphQL Client</Title>
    <Description>DI-friendly, thread-safe GraphQL client factory for Sitecore with per-client OAuth2 authentication, 401 retry support, and optional HTTP resilience.</Description>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageTags>sitecore;graphql;httpclient;oauth;token;client;resilience;dotnet</PackageTags>

    <!-- Build Configuration -->
    <Features>strict</Features>

    <!-- Assembly Information -->
    <AssemblyTitle>Sitecore GraphQL Client</AssemblyTitle>
    <AssemblyDescription>GraphQL client factory for Sitecore with per-client token handling, HTTP resilience, and DI</AssemblyDescription>
    <AssemblyConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</AssemblyConfiguration>
    <AssemblyConfiguration Condition="'$(Configuration)' != 'Debug'">Release</AssemblyConfiguration>
    <AssemblyCompany>Open Source</AssemblyCompany>
    <AssemblyProduct>Sitecore.API.Foundation.GraphQL</AssemblyProduct>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL.Client" />
    <PackageReference Include="GraphQL.Client.Abstractions" />
    <PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="SitecoreAPIAuthorization" />
  </ItemGroup>

</Project>
