<Project>
  <PropertyGroup>
    <!-- Disable parallel multi-TFM inner builds to prevent file-lock races in .NET 10 SDK -->
    <BuildInParallel Condition="'$(TargetFrameworks)' != ''">false</BuildInParallel>

    <!-- Suppress missing XML doc warnings for non-packable test and benchmark projects -->
    <NoWarn Condition="'$(IsPackable)' != 'true'">$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
